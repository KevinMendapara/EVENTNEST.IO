# =========================================================================
# EventNest - Environment Variables Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the '.env' file with real credentials to source control.
# =========================================================================

# Server Settings
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://eventnest.io

# Supabase Configurations
# (Anon key is safe for frontend under RLS policies; Service Role key must stay secret on the server)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Payment Provider Credentials
# (Publishable keys are exposed to client; Secret keys must run strictly on backend)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Third-Party API Keys
# (These keys are protected behind the Express backend proxy routes)
TMDB_API_KEY=your_tmdb_api_key_here
LASTFM_API_KEY=your_lastfm_api_key_here
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Public Client-Safe Identifiers
# (These can be accessed directly on the frontend but are configured here for completeness)
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_SERVICE_ID=your_emailjs_service_id_here
EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
